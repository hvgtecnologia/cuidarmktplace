# =============================================================================
# Cuide+ — variáveis de ambiente
# Copie para .env.local e preencha. .env*.local está no .gitignore.
# NUNCA commite valores reais. Nada sensível pode levar prefixo NEXT_PUBLIC_.
# =============================================================================

# ---- Supabase: públicas (seguro expor no browser) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- App --------------------------------------------------------------------
# Usado no redirectTo do OAuth do Google (src/app/actions.ts)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# SOMENTE SERVIDOR — jamais com NEXT_PUBLIC_.
# =============================================================================

# ---- Supabase: service role (bypassa RLS — só em server actions/route) ------
SUPABASE_SERVICE_ROLE_KEY=

# ---- Verificação de identidade ----------------------------------------------
REPLICATE_API_TOKEN=

# ---- Pagamentos -------------------------------------------------------------
# Qual adaptador usar. 'fake' roda o fluxo completo (cobrança, Pix, webhook,
# liberação de plano) sem conta em provedor nenhum — é o padrão em dev.
# 'asaas' já tem adaptador pronto (src/server/domain/payments/providers/
# asaas.provider.ts), mas NUNCA foi testado contra uma conta real.
PAYMENT_PROVIDER=fake

# Segredo do provedor FALSO (dev) para assinar/validar o webhook simulado.
# Não confundir com ASAAS_WEBHOOK_TOKEN abaixo — cada provedor tem o seu.
PAYMENT_WEBHOOK_SECRET=

# Necessária para processar webhook: ele chega SEM sessão de usuário, então o
# RLS não se aplica e é preciso a service role. SÓ servidor.
# SUPABASE_SERVICE_ROLE_KEY já está declarada acima.

# ---- Asaas (só se PAYMENT_PROVIDER=asaas) -----------------------------------
# Painel Asaas → Integrações → API. Mandado no header access_token.
ASAAS_API_KEY=
# Sandbox para testar sem dinheiro de verdade; troque para
# https://api.asaas.com/v3 só em produção, com uma chave de produção.
ASAAS_API_BASE=https://api-sandbox.asaas.com/v3
# Token que você escolhe ao cadastrar o webhook no painel Asaas (aba
# Integrações → Webhooks). Precisa do MESMO valor nos dois lados. Habilite
# pelo menos PAYMENT_CONFIRMED, PAYMENT_RECEIVED e PAYMENT_OVERDUE — são os
# únicos eventos que o adaptador interpreta.
# URL do webhook: <NEXT_PUBLIC_APP_URL>/api/webhooks/payments/asaas
ASAAS_WEBHOOK_TOKEN=

# ---- Faxina dos documentos de verificação -----------------------------------
# Certificado e RG são apagados após 7 dias por /api/cron/purge-documents.
# A rota exige o header: Authorization: Bearer <CRON_SECRET>.
# SEM este valor a rota responde 503 e NÃO roda — o padrão é fechado.
# Em Vercel, agende em vercel.json:
#   { "crons": [{ "path": "/api/cron/purge-documents", "schedule": "0 4 * * *" }] }
# A faxina também precisa de SUPABASE_SERVICE_ROLE_KEY (declarada acima).
CRON_SECRET=
